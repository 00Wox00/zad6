<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/watch_black"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="E-mail"
            android:textColor="@color/watch_blue"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/watch_blue"
            android:hint="you@example.com"
            android:inputType="textEmailAddress"
            android:textColor="@color/watch_white"
            android:textColorHint="@color/watch_hint"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Пароль"
            android:textColor="@color/watch_blue"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/watch_blue"
            android:hint="Ваш пароль"
            android:inputType="textPassword"
            android:textColor="@color/watch_white"
            android:textColorHint="@color/watch_hint"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnSignIn"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/watch_blue"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Войти"
        android:textColor="@color/watch_white"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>